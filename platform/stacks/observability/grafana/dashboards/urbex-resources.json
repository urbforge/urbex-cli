{
  "uid": "urbex-resources",
  "title": "Urbex resources",
  "tags": [
    "urbex"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "description": "CPU, memory, disk and network of every Urbex LXC: kind=platform (base services) or kind=app (projects' services). CPU is the busy time (user, system, ...) over the LXC's CPUs: inside an LXC the idle counter is unreliable.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "kind",
        "label": "Kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "urbex-prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\"}, kind)",
          "refId": "var",
          "qryType": 1
        },
        "definition": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\"}, kind)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "urbex-prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\"}, project)",
          "refId": "var",
          "qryType": 1
        },
        "definition": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\"}, project)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "urbex-prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\"}, env)",
          "refId": "var",
          "qryType": 1
        },
        "definition": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\"}, env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "urbex-prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\"}, service)",
          "refId": "var",
          "qryType": 1
        },
        "definition": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "LXC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "urbex-prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\"}, host)",
          "refId": "var",
          "qryType": 1
        },
        "definition": "label_values({__name__=~\"node_memory_MemTotal_bytes|container_memory_working_set_bytes\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "table",
      "title": "Now, per LXC",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "targets": [
        {
          "refId": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval])) / count by (kind, project, service, env, host) (node_cpu_seconds_total{mode=\"idle\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host) (urbex_lxc_memory_usage_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"} - urbex_lxc_memory_cache{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}) / max by (kind, project, service, env, host) (node_memory_MemTotal_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "Disk",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "MemTotal",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "max by (kind, project, service, env, host) (node_memory_MemTotal_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true,
              "mountpoint": true
            },
            "renameByName": {
              "Value #CPU": "CPU %",
              "Value #Memory": "Memory %",
              "Value #Disk": "Disk %",
              "Value #MemTotal": "Memory"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval])) / count by (kind, project, service, env, host) (node_cpu_seconds_total{mode=\"idle\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} ({{host}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host) (urbex_lxc_memory_usage_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"} - urbex_lxc_memory_cache{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}) / max by (kind, project, service, env, host) (node_memory_MemTotal_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} ({{host}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Root disk used",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} ({{host}})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network in",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "sum by (kind, project, service, env, host) (rate(node_network_receive_bytes_total{device!=\"lo\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} ({{host}})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network out",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "sum by (kind, project, service, env, host) (rate(node_network_transmit_bytes_total{device!=\"lo\", kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} ({{host}})"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Now, per container",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "targets": [
        {
          "refId": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host, container) (rate(container_cpu_usage_seconds_total{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "sum by (kind, project, service, env, host, container) (container_memory_working_set_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true,
              "mountpoint": true
            },
            "renameByName": {
              "Value #CPU": "CPU % (of a core)",
              "Value #Memory": "Memory"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "description": "Each container's CPU (% of one core) and memory, labelled with its own kind: the services, and the agents (Periphery, Alloy) next to them."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU (% of a core)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "100 * sum by (kind, project, service, env, host, container) (rate(container_cpu_usage_seconds_total{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} {{container}} ({{host}})"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container memory",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "urbex-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "urbex-prometheus"
          },
          "expr": "sum by (kind, project, service, env, host, container) (container_memory_working_set_bytes{kind=~\"$kind\", project=~\"$project\", env=~\"$env\", service=~\"$service\", host=~\"$host\"})",
          "legendFormat": "{{kind}} {{service}} {{project}} {{env}} {{container}} ({{host}})"
        }
      ]
    }
  ]
}
