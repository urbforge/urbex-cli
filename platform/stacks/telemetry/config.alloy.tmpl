// Generated by urbex from urbex-cli's platform/stacks/telemetry - do not
// edit: changes are overwritten. Deployed by Komodo as the Stack
// urbex-telemetry-{{ .Host }} (ADR-0027): what this LXC sends to the
// platform's observability stack, and how it is labelled (ADR-0023). Every
// log stream and metric series gets one kind - platform, app or agent -
// with its service and, for a project's, its project and environment: a
// container's from its Docker labels (urbex.kind, urbex.service,
// urbex.project, urbex.env), this LXC's own (its main service's) otherwise.

// --- resources: the LXC's CPU, memory, disk and network ----------------

prometheus.exporter.unix "lxc" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "lxc" {
  targets         = prometheus.exporter.unix.lxc.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.lxc.receiver]
}

// The LXC's metrics keep its main service's kind.
prometheus.relabel "lxc" {
  forward_to = [prometheus.remote_write.platform.receiver]
{{- range .LXCLabels }}
  rule {
    target_label = "{{ .Key }}"
    replacement  = "{{ .Value }}"
  }
{{- end }}
}

// --- resources: each container's CPU, memory and health -------------------

prometheus.exporter.cadvisor "containers" {
  docker_host                  = "unix:///var/run/docker.sock"
  docker_only                  = true
  store_container_labels       = false
  allowlisted_container_labels = ["urbex.kind", "urbex.service", "urbex.project", "urbex.env"]
  enabled_metrics              = ["cpu", "memory"]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.platform.receiver]

  // health_state is the result of the container's healthcheck (1 healthy,
  // 0 starting or unhealthy, -1 none), for dashboards and alerts. It lags
  // Docker by a scrape or more, so nothing waits on it (urbex-cli#43).
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|health_state)"
    action        = "keep"
  }
  // Only the containers: cAdvisor also reports the LXC's own cgroup,
  // with no container name - the LXC's metrics already cover it.
  rule {
    source_labels = ["name"]
    regex         = ""
    action        = "drop"
  }
  rule {
    source_labels = ["name"]
    target_label  = "container"
  }
{{- range .LXCLabels }}
  rule {
    target_label = "{{ .Key }}"
    replacement  = "{{ .Value }}"
  }
{{- end }}
  rule {
    source_labels = ["container_label_urbex_kind"]
    regex         = "(.+)"
    target_label  = "kind"
  }
  rule {
    source_labels = ["container_label_urbex_service"]
    regex         = "(.+)"
    target_label  = "service"
  }
  rule {
    source_labels = ["container_label_urbex_project"]
    regex         = "(.+)"
    target_label  = "project"
  }
  rule {
    source_labels = ["container_label_urbex_env"]
    regex         = "(.+)"
    target_label  = "env"
  }
  rule {
    regex  = "container_label_.*|id|image|name|cpu"
    action = "labeldrop"
  }
}

prometheus.remote_write "platform" {
  endpoint {
    url = "{{ .PrometheusWriteURL }}"
  }
  external_labels = {
    host = "{{ .Host }}",
  }
}

// --- logs: every container of this LXC, agents included -----------------

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

// Filtered and labelled here, at discovery: relabel_rules on
// loki.source.docker don't drop targets.
discovery.relabel "containers" {
  targets = discovery.docker.local.targets
{{- if not .Logs }}

  // The project's manifest says observability.logs: false - its
  // service's logs stay here; the agents' are shipped.
  rule {
    source_labels = ["__meta_docker_container_label_urbex_kind"]
    regex         = "app"
    action        = "drop"
  }
{{- end }}
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
{{- range .LXCLabels }}
  rule {
    target_label = "{{ .Key }}"
    replacement  = "{{ .Value }}"
  }
{{- end }}
  rule {
    source_labels = ["__meta_docker_container_label_urbex_kind"]
    regex         = "(.+)"
    target_label  = "kind"
  }
  rule {
    source_labels = ["__meta_docker_container_label_urbex_service"]
    regex         = "(.+)"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_urbex_project"]
    regex         = "(.+)"
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_urbex_env"]
    regex         = "(.+)"
    target_label  = "env"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.platform.receiver]
}

loki.write "platform" {
  endpoint {
    url = "{{ .LokiPushURL }}"
  }
  external_labels = {
    host = "{{ .Host }}",
  }
}
