# Deployed by Komodo as the Stack "urbex-gitea", from this file on the
# server (/opt/urbex; ADR-0027); written - and, when Komodo can't, restored
# - by urbex bootstrap. A copy is in the GitOps repo, platform/gitea/, for
# review: change the template in urbex-cli, not the copy.
# Managed by urbex bootstrap - see docs/decisions/0004-gitops-gitea-komodo.md
# and docs/decisions/0018-image-build-komodo-gitea-registry.md in
# urbforge/urbex.
services:
  gitea:
    image: gitea/gitea:1.24
    labels:
      urbex.kind: "platform"
      urbex.service: "gitea"
    restart: unless-stopped
    environment:
      - USER_UID=1000
      - USER_GID=1000
      # By internal name (docs/decisions/0027-service-conventions.md): the
      # container registry's token endpoint is derived from ROOT_URL, so it
      # must be reachable from every LXC that pulls images.
      - GITEA__server__DOMAIN={{ gitea_url | urlsplit('hostname') }}
      - GITEA__server__ROOT_URL={{ gitea_url }}/
      - GITEA__security__INSTALL_LOCK=true
      - GITEA__service__DISABLE_REGISTRATION=true
      - GITEA__packages__ENABLED=true
      # Komodo's webhook listener is on the LAN; Gitea only delivers to
      # public addresses by default.
      - GITEA__webhook__ALLOWED_HOST_LIST=private
    volumes:
      - gitea-data:/data
    ports:
      - "3000:3000"
      - "2222:22"

volumes:
  gitea-data:
