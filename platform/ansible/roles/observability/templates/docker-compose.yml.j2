# Managed by urbex bootstrap - see docs/architecture.md#observability-prometheus--grafana--loki
# in urbforge/urbex.
#
# Project LXCs ship their services' logs to Loki with a Grafana Alloy
# agent (role logs, installed by urbex apply). Grafana comes with Loki and
# Prometheus as data sources and an "Urbex logs" dashboard.
services:
  prometheus:
    image: prom/prometheus:latest
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"

  loki:
    image: docker.io/grafana/loki:3.7.8
    restart: unless-stopped
    volumes:
      - loki-data:/loki
    ports:
      - "3100:3100"

  grafana:
    image: docker.io/grafana/grafana:13.2.3
    restart: unless-stopped
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ lookup('env', 'URBEX_GRAFANA_ADMIN_PASSWORD') }}
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "3000:3000"
    depends_on:
      - prometheus
      - loki

volumes:
  prometheus-data:
  loki-data:
  grafana-data:
