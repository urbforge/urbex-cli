global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
# The LXCs' resource metrics are pushed by their telemetry agents (remote
# write), labelled kind/service/host (and project/env for apps). Scraping
# the services' own metrics (urbex.yaml's observability.metrics) is not
# implemented yet.
