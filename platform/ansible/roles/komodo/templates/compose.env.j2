# Managed by urbex bootstrap. Contains secrets: mode 0600, never commit.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD={{ lookup('env', 'URBEX_KOMODO_DB_PASSWORD') }}
TZ=Etc/UTC

KOMODO_HOST={{ komodo_url }}
KOMODO_TITLE=Urbex Komodo
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME={{ komodo_admin_username }}
KOMODO_INIT_ADMIN_PASSWORD={{ lookup('env', 'URBEX_KOMODO_ADMIN_PASSWORD') }}
KOMODO_FIRST_SERVER_NAME={{ komodo_server_name }}
KOMODO_DISABLE_INIT_RESOURCES=true
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_WEBHOOK_SECRET={{ lookup('env', 'URBEX_KOMODO_WEBHOOK_SECRET') }}
KOMODO_JWT_SECRET={{ lookup('env', 'URBEX_KOMODO_JWT_SECRET') }}

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS={{ komodo_server_name }}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
