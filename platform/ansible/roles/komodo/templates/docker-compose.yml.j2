# Deployed by Komodo as the Stack "urbex-komodo", from this file on the
# server (/opt/urbex; ADR-0027); written - and, when Komodo can't, restored
# - by urbex bootstrap. A copy is in the GitOps repo, platform/komodo/, for
# review: change the template in urbex-cli, not the copy.
# Managed by urbex bootstrap - see docs/decisions/0004-gitops-gitea-komodo.md
# and docs/decisions/0018-image-build-komodo-gitea-registry.md in
# urbforge/urbex. Based on upstream's ferretdb.compose.yaml
# (https://github.com/moghtech/komodo/tree/main/compose).
#
# Komodo Core, its database (Postgres + FerretDB), and a Periphery agent
# registered as server/builder "{{ komodo_server_name }}", which builds
# project images on this LXC. Core and Periphery must run the exact same
# version.
services:
  postgres:
    image: ghcr.io/ferretdb/postgres-documentdb:17-0.106.0-ferretdb-2.5.0
    labels:
      komodo.skip:
      urbex.kind: "platform"
      urbex.service: "komodo"
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: ${KOMODO_DATABASE_USERNAME}
      POSTGRES_PASSWORD: ${KOMODO_DATABASE_PASSWORD}
      POSTGRES_DB: postgres

  ferretdb:
    image: ghcr.io/ferretdb/ferretdb:2.5.0
    labels:
      komodo.skip:
      urbex.kind: "platform"
      urbex.service: "komodo"
    restart: unless-stopped
    depends_on:
      - postgres
    volumes:
      - ferretdb-state:/state
    environment:
      FERRETDB_POSTGRESQL_URL: postgres://${KOMODO_DATABASE_USERNAME}:${KOMODO_DATABASE_PASSWORD}@postgres:5432/postgres

  core:
    image: ghcr.io/moghtech/komodo-core:{{ komodo_version }}
    labels:
      urbex.kind: "platform"
      urbex.service: "komodo"
    init: true
    restart: unless-stopped
    depends_on:
      - ferretdb
    ports:
      - "9120:9120"
    env_file: ./compose.env
    environment:
      KOMODO_DATABASE_ADDRESS: ferretdb:27017
    volumes:
      - keys:/config/keys
      - /etc/komodo/backups:/backups

  periphery:
    image: ghcr.io/moghtech/komodo-periphery:{{ komodo_version }}
    labels:
      urbex.kind: "agent"
      urbex.service: "periphery"
{% if urbex_project | default('') %}
      urbex.project: "{{ urbex_project }}"
{% endif %}
{% if urbex_env | default('') %}
      urbex.env: "{{ urbex_env }}"
{% endif %}
    init: true
    restart: unless-stopped
    depends_on:
      - core
    env_file: ./compose.env
    volumes:
      - keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      - /etc/komodo:/etc/komodo
      # The bootstrap services' compose files, which Komodo deploys as
      # files-on-host Stacks (ADR-0027): Periphery reads them here.
      - /opt/urbex:/opt/urbex

volumes:
  postgres-data:
  ferretdb-state:
  keys:
