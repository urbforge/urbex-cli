# Managed by urbex apply - see docs/decisions/0002-app-manifest-in-app-repo.md
# and docs/manifest-spec.md in urbforge/urbex.
#
# TODO: docker_image is a placeholder reference (see the comment in
# internal/provision). Actually building an image from the service's
# Dockerfile (runtime: docker) or from source (runtime: java/python/go)
# and pushing it somewhere this LXC can pull from is not yet implemented
# - tracked alongside `urbex deploy` and the Komodo build pipeline.
services:
  app:
    image: "{{ docker_image }}"
    restart: unless-stopped
{% if env_vars is defined and env_vars %}
    environment:
{% for key, value in env_vars.items() %}
      - {{ key }}={{ value }}
{% endfor %}
{% endif %}
    ports:
      - "{{ container_port }}:{{ container_port }}"
{% if healthcheck_path is defined and healthcheck_path %}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ container_port }}{{ healthcheck_path }}"]
      interval: 30s
      timeout: 5s
      retries: 3
{% endif %}
