# Managed by urbex apply - see docs/decisions/0002-app-manifest-in-app-repo.md
# and docs/manifest-spec.md in urbforge/urbex.
#
# docker_image is pinned to an immutable commit tag of the image Komodo
# built from the app repo - see
# docs/decisions/0018-image-build-komodo-gitea-registry.md.
services:
  app:
    image: "{{ docker_image }}"
    restart: unless-stopped
    environment:
      - PORT={{ container_port }}
{% for key, value in (env_vars | default({})).items() %}
      - {{ key }}={{ value }}
{% endfor %}
    ports:
      - "{{ container_port }}:{{ container_port }}"
{% if healthcheck_path is defined and healthcheck_path %}
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ container_port }}{{ healthcheck_path }}"]
      interval: 30s
      timeout: 5s
      retries: 3
{% endif %}
