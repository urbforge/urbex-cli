# Managed by urbex bootstrap - see docs/decisions/0008-keycloak-scope.md
# and docs/decisions/0014-keycloak-realm-per-project.md in urbforge/urbex.
#
# Runs in dev mode (start-dev) for this first bootstrap scaffold. Running
# Keycloak in production mode (proper database, hostname, TLS) is a
# follow-up, not yet implemented.
services:
  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    restart: unless-stopped
    command: start-dev
    environment:
      - KEYCLOAK_ADMIN=admin
      - KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}
{% if keycloak_public_url | default('') %}
      # Public through the platform's Cloudflare Tunnel (ADR-0022): the
      # issuer users and apps see; services on the LAN may still use the
      # LAN address for back-channel calls.
      - KC_HOSTNAME={{ keycloak_public_url }}
      - KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
      - KC_PROXY_HEADERS=xforwarded
      - KC_HTTP_ENABLED=true
{% endif %}
    volumes:
      - keycloak-data:/opt/keycloak/data
    ports:
      - "8080:8080"

volumes:
  keycloak-data:
