# Deployed by Komodo as the Stack "urbex-technitium", from this file on the
# server (/opt/urbex; ADR-0027); written - and, when Komodo can't, restored
# - by urbex bootstrap. A copy is in the GitOps repo, platform/technitium/, for
# review: change the template in urbex-cli, not the copy.
# Managed by urbex bootstrap - see docs/decisions/0007-technitium-configurable-domain.md
# in urbforge/urbex.
services:
  technitium:
    image: technitium/dns-server:latest
    labels:
      urbex.kind: "platform"
      urbex.service: "technitium"
    restart: unless-stopped
    environment:
      - DNS_SERVER_DOMAIN={{ inventory_hostname }}
      # Non-interactive setup: without it the admin account is only
      # reachable through the first-run web wizard, and urbex bootstrap
      # can't mint an API token for it. See
      # docs/decisions/0026-technitium-internal-dns-records.md in
      # urbforge/urbex.
      # The admin password is in technitium.env, on the server only.
    env_file: ./technitium.env
    volumes:
      - technitium-data:/etc/dns
    ports:
      - "53:53/udp"
      - "53:53/tcp"
      - "5380:5380"

volumes:
  technitium-data:
