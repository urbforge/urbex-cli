#!/bin/bash
# urbex-op: run urbex from a container, against a workspace directory that
# holds everything a platform needs on the operator's side. See README.md.
#
#   urbex-op build                   build the operator image from this checkout
#   urbex-op [-w DIR] init           create the workspace: keys, folders
#   urbex-op [-w DIR] set KEY        store a credential in the workspace (asks for it)
#   urbex-op [-w DIR] shell          a shell in the container, ready to run urbex
#   urbex-op [-w DIR] 'COMMANDS'     run COMMANDS (bash) in the container
#
# DIR defaults to $URBEX_WORKSPACE, then ~/urbex-workspace. Tokens come from
# the environment if set (URBEX_PROXMOX_TOKEN, URBEX_CLOUDFLARE_TOKEN), else
# from the workspace's credentials file - 'set proxmoxToken' puts them there.
set -euo pipefail

WS=${URBEX_WORKSPACE:-$HOME/urbex-workspace}
if [ "${1:-}" = "-w" ]; then WS=$2; shift 2; fi
IMAGE=${URBEX_OPERATOR_IMAGE:-urbex-operator}
REPO=$(cd "$(dirname "$0")/../.." && pwd)
ENGINE=$(command -v podman || command -v docker || { echo "urbex-op: podman or docker is needed" >&2; exit 1; })
# Files the container writes stay owned by you: podman maps your user in.
# macOS bash 3.2 calls an empty "${a[@]}" unbound under set -u: expand arrays as ${a[@]+"${a[@]}"}.
USERNS=(); [[ "$ENGINE" == *podman ]] && USERNS=(--userns keep-id)

case "${1:-}" in
  ""|-h|--help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  build)
    # Go's and mise's versions come from mise.toml, like every other tool's.
    pinned() { sed -n "s/^$1 = \"\(.*\)\"\$/\1/p" "$REPO/mise.toml"; }
    exec "$ENGINE" build -t "$IMAGE" --build-arg "GO_VERSION=$(pinned go)" --build-arg "MISE_VERSION=$(pinned min_version)" \
      -f "$REPO/tools/operator/Containerfile" "$REPO" ;;
  set)
    KEY=${2:?usage: urbex-op set KEY - e.g. proxmoxToken, cloudflareToken, ageKey}
    [ -d "$WS/home/.urbex" ] || { echo "urbex-op: no workspace at $WS - run init first" >&2; exit 1; }
    VALUE=
    if [ -t 0 ]; then read -rsp "$KEY: " VALUE || true; echo; else IFS= read -r VALUE || true; fi
    [ -n "$VALUE" ] || { echo "urbex-op: empty value, nothing stored" >&2; exit 1; }
    # Written with the image's Python (Ansible's, which has PyYAML), so the file stays valid YAML and
    # keeps every other credential; mode 0600.
    printf '%s' "$VALUE" | "$ENGINE" run --rm -i ${USERNS[@]+"${USERNS[@]}"} --user "$(id -u):$(id -g)" \
      -v "$WS/home/.urbex:/c:z" "$IMAGE" urbex-python -c '
import os, sys, yaml
path = "/c/credentials.yaml"
data = {}
if os.path.exists(path):
    data = yaml.safe_load(open(path)) or {}
data[sys.argv[1]] = sys.stdin.read()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    yaml.safe_dump(data, f, default_flow_style=False)
os.chmod(path, 0o600)
' "$KEY"
    echo "Stored $KEY in $WS/home/.urbex/credentials.yaml."
    exit 0 ;;
  init)
    mkdir -p "$WS/home/.ssh" "$WS/home/.urbex" "$WS/gitops" "$WS/projects"
    chmod 700 "$WS/home/.ssh" "$WS/home/.urbex"
    [ -f "$WS/home/.ssh/urbex" ] || ssh-keygen -q -t ed25519 -N "" -C urbex -f "$WS/home/.ssh/urbex"
    if [ ! -f "$WS/home/age.key" ]; then
      "$ENGINE" run --rm -v "$WS/home:/h:z" "$IMAGE" age-keygen -o /h/age.key 2>/dev/null
      chmod 600 "$WS/home/age.key"
    fi
    cat <<NEXT
Workspace ready: $WS
  SSH public key (proxmox.sshPublicKey):  $(cat "$WS/home/.ssh/urbex.pub")
  age key (back it up - secrets can't be recovered without it): $WS/home/age.key
Next:
  export URBEX_PROXMOX_TOKEN='user@pve!token=secret'
  urbex-op -w $WS 'urbex bootstrap'      # scaffolds gitops/urbex.platform.yaml; edit it, run again
NEXT
    exit 0 ;;
esac

[ -d "$WS/home" ] || { echo "urbex-op: no workspace at $WS - run 'urbex-op -w $WS init' first" >&2; exit 1; }
CMD=$1
[ "$CMD" = shell ] && CMD="exec bash"
TTY=(); [ -t 0 ] && [ -t 1 ] && TTY=(-it)

# OpenSSH (Ansible's transport) refuses to run for a uid with no passwd entry. Podman's keep-id adds
# one; with docker, mount the image's /etc/passwd plus a line for your uid (502 on a Mac, say).
# Regenerated when the image changes.
PASSWD=()
if [[ "$ENGINE" != *podman ]]; then
  P="$WS/home/.urbex-op"; ID=$("$ENGINE" image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null || true)
  if [ ! -s "$P/passwd" ] || [ "$(cat "$P/image" 2>/dev/null)" != "$ID:$(id -u)" ]; then
    mkdir -p "$P"
    { "$ENGINE" run --rm "$IMAGE" cat /etc/passwd | grep -v "^[^:]*:[^:]*:$(id -u):"
      echo "urbex:x:$(id -u):$(id -g):urbex:/work/home:/bin/bash"; } > "$P/passwd.new"
    mv "$P/passwd.new" "$P/passwd"; echo "$ID:$(id -u)" > "$P/image"
  fi
  PASSWD=(-v "$P/passwd:/etc/passwd:ro")
fi

# SSH can't create its control sockets on a folder shared from macOS (virtiofs, colima or podman machine):
# ANSIBLE_SSH_CONTROL_PATH_DIR keeps them in the container, as e2e/inside.sh does.
exec "$ENGINE" run --rm ${TTY[@]+"${TTY[@]}"} --network host ${USERNS[@]+"${USERNS[@]}"} ${PASSWD[@]+"${PASSWD[@]}"} --user "$(id -u):$(id -g)" \
  -e HOME=/work/home -e URBEX_GITOPS_REPO=/work/gitops -e URBEX_HOST_WORKSPACE="$WS" \
  -e ANSIBLE_SSH_CONTROL_PATH_DIR=/tmp/ansible-cp \
  -e URBEX_PROXMOX_TOKEN -e URBEX_CLOUDFLARE_TOKEN -e URBEX_AGE_KEY \
  -v "$WS:/work:z" -w /work "$IMAGE" bash -c '
    set -e
    if [ -f /work/home/age.key ] && [ -z "${URBEX_AGE_KEY:-}" ]; then
      export URBEX_AGE_KEY="$(grep AGE-SECRET-KEY /work/home/age.key)"
    fi
    eval "$(ssh-agent -s)" >/dev/null; ssh-add -q /work/home/.ssh/urbex
    trap "ssh-agent -k >/dev/null" EXIT
    git config --global user.name >/dev/null || git config --global user.name urbex
    git config --global user.email >/dev/null || git config --global user.email urbex@localhost
    '"$CMD"
