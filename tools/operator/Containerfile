# The operator image: urbex, built from this checkout, and everything it
# shells out to - terraform, ansible-playbook, sops, age, git, ssh - at the
# versions pinned in mise.toml. Build it with `tools/operator/urbex-op
# build` (or `mise run operator-image`), which passes mise.toml's Go and
# mise versions as GO_VERSION and MISE_VERSION.
ARG GO_VERSION
FROM docker.io/library/golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/urbex ./cmd/urbex

FROM docker.io/library/debian:13-slim
ARG MISE_VERSION
# The tools, from mise.toml, linked into /usr/local/bin; mise itself and
# uv are only needed to install them, and are removed in the same layer.
# urbex-python is Ansible's interpreter, which has PyYAML (urbex-op set
# uses it to edit credentials.yaml).
# OpenSSL's ARM feature detection crashes (SIGILL) in Linux VMs on Apple
# M4 - podman on a Mac - when cryptography loads; ignored elsewhere.
ENV OPENSSL_armcap=0
ENV MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/opt/mise/config MISE_CACHE_DIR=/tmp/mise-cache MISE_YES=1
WORKDIR /opt/mise/tools
COPY mise.toml ./
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-client git curl jq ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && arch=$(uname -m | sed "s/x86_64/x64/;s/aarch64/arm64/") \
 && curl -fsSL -o /tmp/mise "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${arch}" \
 && chmod +x /tmp/mise \
 && /tmp/mise trust \
 && /tmp/mise install terraform sops age python uv pipx:ansible-core \
 && for d in $(/tmp/mise bin-paths terraform sops age pipx:ansible-core); do ln -sf "$d"/* /usr/local/bin/; done \
 && printf '#!/bin/sh\nexec %s "$@"\n' "$(sed -n '1s/^#!//p' "$(readlink -f /usr/local/bin/ansible-playbook)")" > /usr/local/bin/urbex-python \
 && chmod +x /usr/local/bin/urbex-python \
 && rm -rf /tmp/mise /tmp/mise-cache "$MISE_DATA_DIR/installs/uv" "$MISE_DATA_DIR/shims"
WORKDIR /
COPY --from=build /out/urbex /usr/local/bin/urbex
